# Melos-style workspace ignores
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
# Committed for the app: CI resolves fresh otherwise, and a dependency
# published yesterday can require a newer Dart than the pinned Flutter ships.
**/pubspec.lock
!app/pubspec.lock
.DS_Store
*.iml
.idea/

# Signing material — never commit
keystore.b64
*.jks
*.p12
*.keystore
android/app/upload-keystore.*
app/android/key.properties

# Xcode / SwiftPM scratch files (generated by `flutter build macos`)
**/.swiftpm/
**/xcuserdata/
